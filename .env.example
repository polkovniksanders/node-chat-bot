# ── Required ────────────────────────────────────────────────────────────────

# Telegram bot token from @BotFather
TELEGRAM_TOKEN=

# Admin user IDs (comma-separated). Use @userinfobot in Telegram to find your ID.
# Legacy single-value form is also accepted (ADMIN_USER_ID=123456789)
ADMIN_USER_IDS=123456789,987654321

# ── AI providers (at least one required) ────────────────────────────────────

# GPTunnel (primary, cheapest) — https://gptunnel.ru
GPTUNNEL_API_KEY=

# Anthropic Claude — https://console.anthropic.com
ANTHROPIC_API_KEY=

# OpenAI — https://platform.openai.com
OPENAI_API_KEY=

# Google Gemini — https://aistudio.google.com
GEMINI_API_KEY=

# HuggingFace (DeepSeek / Qwen / Llama) — https://huggingface.co/settings/tokens
HF_TOKEN=

# Groq — https://console.groq.com
GROQ_API_KEY=

# DeepSeek — https://platform.deepseek.com
DEEPSEEK_API_KEY=

# ── Optional external APIs ───────────────────────────────────────────────────

# GeoNames free account — https://www.geonames.org/login
# Used for "place of the day". Falls back to curated list if empty.
GEONAMES_USERNAME=

# OpenWeatherMap — https://openweathermap.org/appid
# Used for weather posts. Falls back to Open-Meteo (free, no auth) if empty.
OPENWEATHERMAP_API_KEY=

# TMDB (The Movie Database) — https://www.themoviedb.org/settings/api
# Used for animal movie posts. Falls back to AI generation if empty.
TMDB_API_KEY=

# YouTube Data API v3 — https://console.cloud.google.com → YouTube Data API v3
# Free quota: 10 000 units/day (1 search = 100 units).
# Falls back to Invidious (public, no auth) then static list if empty.
YOUTUBE_API_KEY=

# ── Legacy migration only (no longer used for posting) ───────────────────────

# If set, CHANNEL_ID is used during first-run migration to populate the
# daily-cycle and sora-videos module chat list. Remove after migration.
# CHANNEL_ID=@your_channel

# If set, EVENTS_CHANNEL_ID is used during first-run migration to populate the
# daily-events module chat list. Remove after migration.
# EVENTS_CHANNEL_ID=-1001234567890

# CHANNEL_CHAT_ID is the numeric id of the channel linked to a group —
# used to detect when users reply to channel posts in the linked group.
# CHANNEL_CHAT_ID=-1001234567890
