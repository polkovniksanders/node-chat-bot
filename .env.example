# ── Required ────────────────────────────────────────────────────────────────

# Telegram bot token from @BotFather
TELEGRAM_TOKEN=

# Your Telegram user ID(s) — find it via @userinfobot in Telegram.
# Comma-separated list is accepted (ADMIN_USER_IDS=123,456) or single ADMIN_USER_ID.
ADMIN_USER_ID=

# Main channel for the 5-day cycle posts (bot must be admin there)
CHANNEL_ID=@my_channel

# ── Polza.ai — единственный LLM-провайдер (OpenAI-совместимый API) ─────────

# API key: https://polza.ai/dashboard/models
POLZA_API_KEY=

# Base URL (по умолчанию https://api.polza.ai/v1)
# POLZA_API_URL=https://api.polza.ai/v1

# Обычная модель (берта/дешёвая) — крон-постинг, новости, контент
# POLZA_MODEL=deepseek-v3-0324

# «Умная» модель — AI-чат и сложные задачи
# POLZA_SMART_MODEL=gpt-4.1-nano

# ── Опциональные внешние API ─────────────────────────────────────────────────

# Channel/group for the events digest (8:55–10:00 posts) and /secret whispers.
# If empty, the events digest is disabled and whispers are not posted.
EVENTS_CHANNEL_ID=

# GeoNames free account — https://www.geonames.org/login
# Used for "place of the day". Falls back to curated list if empty.
GEONAMES_USERNAME=

# OpenWeatherMap — https://openweathermap.org/appid
# Used for weather posts. Falls back to Open-Meteo (free, no auth) if empty.
OPENWEATHERMAP_API_KEY=

# TMDB (The Movie Database) — https://www.themoviedb.org/settings/api
# Used for animal movie posts. Falls back to AI generation if empty.
TMDB_API_KEY=

# YouTube Data API v3 — https://console.cloud.google.com → YouTube Data API v3
# Free quota: 10 000 units/day (1 search = 100 units).
# Falls back to Invidious (public, no auth) then static list if empty.
YOUTUBE_API_KEY=